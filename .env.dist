# 跃科高校人事系统环境模板（MySQL-only）
# `make prod` 会读取本文件复制出的 .env。复制后必须替换所有 change-me 值。
# 容器内数据库/Redis 主机名固定使用 db / redis；本机开发直接使用 `make dev`。

DEBUG=0
HORILLA_ENV=production
SECRET_KEY=change-me-generate-a-unique-secret
ALLOWED_HOSTS=hr.example.edu.cn
CSRF_TRUSTED_ORIGINS=https://hr.example.edu.cn
TIME_ZONE=Asia/Shanghai

# Canonical database contract: MySQL only. `make prod` 在 web/release 容器内使用 db:3306。
DATABASE_URL=mysql://renshi_user:change-me@db:3306/renshi_db?charset=utf8mb4
DB_ENGINE=django.db.backends.mysql
DB_NAME=renshi_db
DB_USER=renshi_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_INIT_PASSWORD=change-me-db-init-password

# Docker MySQL service variables.
MYSQL_DATABASE=renshi_db
MYSQL_USER=renshi_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Tenant / permission gates must stay enabled in production.
COMPANY_SCOPED_PERMISSIONS=True
TENANT_FAIL_CLOSED=True
PLATFORM_TENANT_ELEVATION_MAX_MINUTES=60

# Shared Redis-backed login throttling. X-Real-IP is trusted only because the
# production Web service is private and receives traffic through bundled Nginx.
FAIL2BAN_MAX_RETRY=5
FAIL2BAN_IP_MAX_RETRY=100
FAIL2BAN_ATTEMPT_WINDOW=900
FAIL2BAN_BAN_TIME=900
FAIL2BAN_TRUST_X_REAL_IP=True
LOGIN_REMEMBER_ME_SECONDS=1209600

# Production email MFA is mandatory. Replace the example SMTP host and sender
# before deployment; production startup rejects local/example destinations.
TWO_FACTORS_AUTHENTICATION=True
MFA_OTP_TTL_SECONDS=300
MFA_OTP_MAX_ATTEMPTS=5
MFA_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_HOST=smtp.example.edu.cn
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-account
EMAIL_HOST_PASSWORD=change-me-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_FAIL_SILENTLY=False
DEFAULT_FROM_EMAIL=noreply@example.edu.cn

# HR04 招聘报名个人信息告知。联系人应填写本校可受理查阅、更正、删除、
# 撤回同意等请求的真实邮箱或电话；保留天数须与本校档案制度一致。
HR04_PRIVACY_NOTICE_VERSION=2026-01
HR04_CANDIDATE_RETENTION_DAYS=730
HR04_PRIVACY_CONTACT=人事处招聘办公室 hr@example.edu.cn 010-00000000
HR04_APPLICATION_MATERIAL_MAX_BYTES=20971520

# HR09/HR11 call HR10's private evidence and time-window APIs. Generate two
# independent random values of at least 32 bytes; never reuse SECRET_KEY.
HR10_HR09_SERVICE_TOKEN=change-me-generate-a-distinct-32-byte-token
HR10_HR11_SERVICE_TOKEN=change-me-generate-a-distinct-32-byte-token

# Authenticated encryption for credentials stored in MySQL. Format is an
# ordered keyring: current-id:fernet-key,previous-id:fernet-key. Generate each
# key with Fernet.generate_key(); never reuse SECRET_KEY or the backup key.
FIELD_ENCRYPTION_KEYS=primary:change-me-generate-a-fernet-key

# Every production multipart upload is streamed through the private ClamAV
# service before business code can read it. This gate cannot be disabled in
# production. The maximum must not exceed Nginx client_max_body_size (50 MiB).
MALWARE_SCAN_REQUIRED=True
MALWARE_SCAN_HOST=clamav
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=10
MALWARE_SCAN_MAX_BYTES=52428800

# HR16 exit saga authority endpoints. Keep tokens secret and provision all
# three before enabling the corresponding required participant in production.
# Comma-separated allowed names: HR15_PAYMENT, HR16_IAM, HR16_ASSET, HR16_FINANCE,
# HR18_SUBMISSION, HR18_EXCHANGE, HR08_IAM, HR08_ACADEMIC. Any named boundary
# becomes a startup gate.
REQUIRED_EXTERNAL_INTEGRATIONS=
HR08_IAM_PROVIDER_URL=
HR08_IAM_PROVIDER_TOKEN=
HR08_IAM_PROVIDER_TIMEOUT_MS=10000
HR08_ACADEMIC_PROVIDER_URL=
HR08_ACADEMIC_PROVIDER_TOKEN=
HR08_ACADEMIC_PROVIDER_TIMEOUT_MS=10000
HR16_IAM_PROVIDER_URL=
HR16_IAM_PROVIDER_TOKEN=
HR16_IAM_PROVIDER_TIMEOUT=10
HR16_ASSET_PROVIDER_URL=
HR16_ASSET_PROVIDER_TOKEN=
HR16_ASSET_PROVIDER_TIMEOUT=10
HR16_FINANCE_PROVIDER_URL=
HR16_FINANCE_PROVIDER_TOKEN=
HR16_FINANCE_PROVIDER_TIMEOUT=10

# HR15 payment/finance gateway. The configured provider code is the code used
# when creating payment instructions. Dispatch uses HTTPS and every terminal
# receipt must be HMAC-SHA256 signed with the separate receipt secret.
HR15_PAYMENT_HTTP_ENDPOINT=
HR15_PAYMENT_HTTP_TOKEN=
HR15_PAYMENT_HTTP_TIMEOUT_SECONDS=15
HR15_PAYMENT_PROVIDER_CODE=UNIVERSITY_FINANCE
HR15_PAYMENT_RECEIPT_HMAC_SECRET=
HR15_PAYMENT_RECEIPT_KEY_ID=

# HR18 formal submission dispatch and signed receipt verification.  Leave the
# endpoint blank to keep submission dispatch explicitly disabled.  The receipt
# secret must be at least 32 bytes and shared only with the trusted platform.
HR18_SUBMISSION_HTTP_ENDPOINT=
HR18_SUBMISSION_HTTP_TOKEN=
HR18_SUBMISSION_HTTP_TIMEOUT_SECONDS=15
HR18_SUBMISSION_HTTP_PROVIDER_VERSION=https-v1
HR18_SUBMISSION_DISPATCH_PROVIDER_KEY=EDU_PLATFORM
HR18_SUBMISSION_RECEIPT_HMAC_SECRET=
HR18_SUBMISSION_RECEIPT_KEY_ID=

# HR18 frozen dataset exchange.  Provider key must match the target mapping.
HR18_EXCHANGE_HTTP_ENDPOINT=
HR18_EXCHANGE_HTTP_TOKEN=
HR18_EXCHANGE_HTTP_TIMEOUT_SECONDS=15
HR18_EXCHANGE_HTTP_PROVIDER_VERSION=https-v1
HR18_EXCHANGE_HTTP_PROVIDER_KEY=EDU_PLATFORM

# Cache / jobs. Production compose creates the `redis` service on the private network.
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0

# TLS terminates at nginx/ingress/LB and must forward X-Forwarded-Proto=https.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Gunicorn capacity. Start with 3 workers (12 request threads) and change only
# after measuring peak RSS and latency with ClamAV plus every worker running.
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info
GUNICORN_PRELOAD=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Meta Graph API calls fail fast instead of occupying request/worker threads forever.
WHATSAPP_HTTP_TIMEOUT_SECONDS=10
WHATSAPP_MEDIA_MAX_BYTES=52428800

# Encrypted backup bundles. BACKUP_STORAGE_PATH must be a durable mounted
# filesystem that is also copied off-host by the infrastructure backup policy.
BACKUP_STORAGE_PATH=/srv/renshi/backups
PRODUCTION_BACKUP_ENCRYPTION_KEY=change-me-at-least-32-random-bytes
PRODUCTION_BACKUP_RETENTION_COUNT=30
PRODUCTION_BACKUP_INTERVAL_HOURS=24
CANONICAL_HR_JOB_BATCH_SIZE=2000

# GCP private media storage (optional)
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account.json"
# GS_BUCKET_NAME="bucket"
# DEFAULT_FILE_STORAGE="horilla.horilla_backends_gcp.PrivateMediaStorage"
