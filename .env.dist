# 跃科高校人事系统环境模板（MySQL-only）
# `make prod` 会读取本文件复制出的 .env。复制后必须替换所有 change-me 值。
# 容器内数据库/Redis 主机名固定使用 db / redis；本机开发直接使用 `make dev`。

DEBUG=0
HORILLA_ENV=production
SECRET_KEY=change-me-generate-a-unique-secret
ALLOWED_HOSTS=hr.example.edu.cn
CSRF_TRUSTED_ORIGINS=https://hr.example.edu.cn
TIME_ZONE=Asia/Shanghai

# Canonical database contract: MySQL only. `make prod` 在 web/release 容器内使用 db:3306。
DATABASE_URL=mysql://horilla_user:change-me@db:3306/horilla_db?charset=utf8mb4
DB_ENGINE=django.db.backends.mysql
DB_NAME=horilla_db
DB_USER=horilla_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_INIT_PASSWORD=change-me-db-init-password

# Docker MySQL service variables.
MYSQL_DATABASE=horilla_db
MYSQL_USER=horilla_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Tenant / permission gates must stay enabled in production.
COMPANY_SCOPED_PERMISSIONS=True
TENANT_FAIL_CLOSED=True
PLATFORM_TENANT_ELEVATION_MAX_MINUTES=60

# HR16 exit saga authority endpoints. Keep tokens secret and provision all
# three before enabling the corresponding required participant in production.
HR16_IAM_PROVIDER_URL=
HR16_IAM_PROVIDER_TOKEN=
HR16_IAM_PROVIDER_TIMEOUT=10
HR16_ASSET_PROVIDER_URL=
HR16_ASSET_PROVIDER_TOKEN=
HR16_ASSET_PROVIDER_TIMEOUT=10
HR16_FINANCE_PROVIDER_URL=
HR16_FINANCE_PROVIDER_TOKEN=
HR16_FINANCE_PROVIDER_TIMEOUT=10

# Cache / jobs. Production compose creates the `redis` service on the private network.
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0

# TLS terminates at nginx/ingress/LB and must forward X-Forwarded-Proto=https.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Optional Gunicorn tuning.
GUNICORN_WORKERS=
GUNICORN_LOG_LEVEL=info

# GCP private media storage (optional)
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account.json"
# GS_BUCKET_NAME="bucket"
# DEFAULT_FILE_STORAGE="horilla.horilla_backends_gcp.PrivateMediaStorage"
