# 跃科高校人事系统环境模板（MySQL-only）
# 生产环境请复制为 .env 后替换全部示例密钥。

DEBUG=True
HORILLA_ENV=development
SECRET_KEY=change-me-generate-a-unique-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Asia/Shanghai

# Canonical database contract: MySQL only.
DATABASE_URL=mysql://horilla_user:change-me@localhost:3306/horilla_db?charset=utf8mb4
DB_ENGINE=django.db.backends.mysql
DB_NAME=horilla_db
DB_USER=horilla_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_INIT_PASSWORD=change-me-db-init-password

# Docker MySQL service variables.
MYSQL_DATABASE=horilla_db
MYSQL_USER=horilla_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Tenant / permission gates must stay enabled in production.
COMPANY_SCOPED_PERMISSIONS=True
TENANT_FAIL_CLOSED=True

# Cache / jobs.
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6379/0

# TLS is normally terminated by nginx / ingress. Turn on only after HTTPS is ready.
SECURE_SSL_REDIRECT=0

# Optional Gunicorn tuning.
GUNICORN_WORKERS=
GUNICORN_LOG_LEVEL=info

# GCP private media storage (optional)
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account.json"
# GS_BUCKET_NAME="bucket"
# DEFAULT_FILE_STORAGE="horilla.horilla_backends_gcp.PrivateMediaStorage"
